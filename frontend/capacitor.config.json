{
  "appId": "com.nexcontrol.app",
  "appName": "NexControl",
  "webDir": "dist/spa",
  "bundledWebRuntime": false,
  "version": "1.0.0",
  "build": "1",
  "resources": "resources",
  "ios": {
    "scheme": "NexControl",
    "bundleId": "com.nexcontrol.app",
    "overridesWebViewPackage": null,
    "contentMode": "origin"
  },
  "android": {
    "buildOptions": {
      "signingType": "apk"
    },
    "packageId": "com.nexcontrol.app"
  },
  "server": {
    "hostname": "localhost",
    "iosScheme": "nexcontrol",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*",
      "http://*:*",
      "https://*:*",
      "http://192.168.*",
      "http://10.*",
      "http://172.16.*",
      "http://172.17.*",
      "http://172.18.*",
      "http://172.19.*",
      "http://172.20.*",
      "http://172.21.*",
      "http://172.22.*",
      "http://172.23.*",
      "http://172.24.*",
      "http://172.25.*",
      "http://172.26.*",
      "http://172.27.*",
      "http://172.28.*",
      "http://172.29.*",
      "http://172.30.*",
      "http://172.31.*",
      "http://localhost:*",
      "https://localhost:*"
    ],
    "iosContentMode": "origin",
    "iosRelativeLoads": true,
    "loadFirst": "config"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
