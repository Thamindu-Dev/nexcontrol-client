# ============================================================
# NexControl Backend - Environment Configuration
# ============================================================
# Copy this file to .env and update with your values

# ============================================================
# SECURITY CONFIGURATION
# ============================================================

# Secret key for JWT token generation (CHANGE THIS IN PRODUCTION!)
# Generate a strong random key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=NexControl-Secret-Key-Change-Me-12345678

# AES encryption key (must be 32 bytes for AES-256)
# This is used to encrypt/decrypt API payloads
AES_KEY=NexControl-AES-Key-32-Bytes-Change!!

# App password for authentication (bcrypt hash will be generated on first run)
# Set this to a strong password for production
APP_PASSWORD_HASH=

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server host (0.0.0.0 for all interfaces, localhost for local only)
HOST=0.0.0.0

# Server port
PORT=8000

# Auto-reload on code changes (development mode)
RELOAD=true

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=nexcontrol.log

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable Docker integration (auto-detected if not set)
DOCKER_ENABLED=true

# Enable GPU temperature monitoring (requires NVIDIA GPU)
GPU_MONITORING_ENABLED=true

# Screenshot quality (1-100, default: 75)
SCREENSHOT_QUALITY=75
